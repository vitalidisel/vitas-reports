# ── VITAS reports (existing app) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # server only, never NEXT_PUBLIC_
CRON_SECRET=change-me                                  # shared by all /api/cron/* and /api/pilot30/cron/* routes

# ── PILOT 30 ─────────────────────────────────────────────────────────────────
# Without NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY the app runs in DEMO mode:
# in-memory store, fictional data, no login. Nothing below is required to run the screens.
OWNER_USER_ID=00000000-0000-0000-0000-000000000000    # Supabase auth user id of the single owner (Vitali)
APP_TIMEZONE=Asia/Jerusalem
API_FOOTBALL_KEY=                                      # API-Sports direct key (x-apisports-key header). Required for live fixtures/results.
ODDS_API_KEY=                                          # Optional. The Odds API v4 — only for a market-paper pilot with an international bookmaker.
WINNER_PROVIDER=                                       # Adapter id for a *verified* Winner odds source. None exists yet; leave empty.
PILOT30_DEMO=                                          # Set to 1 to force demo mode even when a database is configured.
PILOT30_DEMO_NOW=                                      # Demo mode only: freeze "now" (ISO instant) for QA/screenshots, e.g. 2026-09-12T07:00:00Z
